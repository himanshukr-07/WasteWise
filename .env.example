# Local Ollama endpoint
OLLAMA_HOST=http://127.0.0.1:11434

# Local model names
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# RAG retrieval
RAG_TOP_K=4

# Local browser origins allowed for API requests
WASTEWISE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:6000,http://localhost:6000

# Logging
WASTEWISE_LOG_LEVEL=INFO
